# --- Нейро-сметчик: пример конфигурации (НЕ содержит секретов) ---
# Все значения по умолчанию безопасны для локального запуска без GPU.

APP_ENV=dev
DB_PATH=data/neuro_smetchik.db

# Локальный OpenAI-совместимый инференс (vLLM / TGI).
# Разрешены ТОЛЬКО хосты внутреннего периметра; внешние AI-API блокируются.
LLM_ENABLED=false
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=qwen2.5-32b-instruct
LLM_TIMEOUT_S=20
LLM_ALLOWED_HOSTS=127.0.0.1,localhost,vllm,llm,host.docker.internal

# Пороги бизнес-логики (см. ТЗ 3.2.4, 6.2, 9)
MATCH_AUTO_ACCEPT=0.85
MATCH_EXTENDED_SEARCH=0.50
MAX_CLARIFICATION_TURNS=5
PARSER_MAX_RETRIES=3
SEARCH_TOP_N=8
SEARCH_SLA_MS=500
DRAFT_SLA_P95_MS=60000
DEFAULT_VAT_RATE=0.20
DEFAULT_OVERHEAD=0.12
DEFAULT_PROFIT=0.08
FOUR_EYES_THRESHOLD=500000

# Безопасность
RATE_LIMIT_PER_MIN=120
MAX_UPLOAD_MB=15
AUDIT_ENABLED=true

# Фирменный шаблон документов
COMPANY_NAME=ООО «СтройИнвест»
COMPANY_INN=7700000000
COMPANY_LOGO=
